# Orca worker commit identities — one bot account per role (GATE 0, 2026-09-27).
# Each *_EMAIL is the account's private noreply address:
#   <ID>+<USERNAME>@users.noreply.github.com
# It MUST be a users.noreply.github.com address: a bare @localhost/@local resolves
# to no account (no avatar), and a legacy username@users.noreply.github.com address
# resolves to whoever currently owns that username. See ORCHESTRATION.md
# §Commit Attribution.
#
# Collaborator state (2026-09-28): coder/tester accepted (write); fixer has a
# pending write invitation to accept. reviewer deliberately has NO seat — the repo
# is public, so read is implicit, and the read-only role needs no permission to
# comment or be requested. Re-verify ids if an account is recreated.

CODER_USERNAME="ernem22-coder"
CODER_ID="334651921"
CODER_EMAIL="${CODER_ID}+${CODER_USERNAME}@users.noreply.github.com"

TESTER_USERNAME="ernem22-tester"
TESTER_ID="334654881"
TESTER_EMAIL="${TESTER_ID}+${TESTER_USERNAME}@users.noreply.github.com"

REVIEWER_USERNAME="ernem22-reviewer"
REVIEWER_ID="334659304"
REVIEWER_EMAIL="${REVIEWER_ID}+${REVIEWER_USERNAME}@users.noreply.github.com"

FIXER_USERNAME="ernem22-fixer"
FIXER_ID="334656510"
FIXER_EMAIL="${FIXER_ID}+${FIXER_USERNAME}@users.noreply.github.com"
