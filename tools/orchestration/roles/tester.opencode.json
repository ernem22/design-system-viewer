{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/deepseek-v4.1-flash",
  "permission": {
    "external_directory": "deny",
    "edit": "deny",
    "write": "deny",
    "*": "allow",
    "bash": {
      "*": "deny",
      "orca orchestration send *": "allow",
      "gh pr view *": "allow",
      "gh pr diff *": "allow",
      "gh pr checks *": "allow",
      "gh issue view *": "allow",
      "git log *": "allow",
      "git show *": "allow",
      "git diff *": "allow",
      "git rev-parse *": "allow",
      "git status": "allow",
      "curl -s http://127.0.0.1:*": "allow",
      "curl http://127.0.0.1:*": "allow",
      "curl -s http://localhost:*": "allow",
      "curl http://localhost:*": "allow",
      "ls *": "allow",
      "cat *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "wc *": "allow",
      "node *": "allow",
      "npx playwright *": "allow",
      "npx --yes playwright *": "allow",
      "rg *--pre*": "deny",
      "git * --output*": "deny",
      "git * --ext-diff*": "deny"
    }
  }
}
