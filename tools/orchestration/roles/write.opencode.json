{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/deepseek-v4.1-flash",
  "permission": {
    "external_directory": "deny",
    "*": "allow",
    "bash": {
      "*": "allow",
      "rm -rf *": "deny",
      "git push --force-if-includes": "deny",
      "git push --force-if-includes *": "deny",
      "git push --force-if-includes --force-with-lease *": "allow",
      "git push --force-with-lease --force-if-includes *": "allow",
      "git push --force": "deny",
      "git push --force *": "deny",
      "git push * --force": "deny",
      "git push * --force *": "deny",
      "git push -f": "deny",
      "git push -f *": "deny",
      "git push * -f": "deny",
      "git push * -f *": "deny",
      "git push * +*": "deny",
      "git reset --hard": "deny",
      "git reset --hard *": "deny",
      "git reset * --hard": "deny",
      "git reset * --hard *": "deny",
      "git clean *": "deny",
      "git worktree *": "deny",
      "orca worktree *": "deny",
      "orca terminal *": "deny",
      "orca orchestration worker-*": "deny",
      "orca orchestration run-*": "deny",
      "rm -fr *": "deny",
      "rm -Rf *": "deny",
      "rm -rF *": "deny",
      "rm -r -f *": "deny",
      "rm -f -r *": "deny",
      "rm -r *": "deny",
      "rm -R *": "deny"
    }
  }
}
