# This shell runs with NODE_ENV=production, which makes npm omit devDependencies
# from an install — `npm ci` then reports success while `app/node_modules/.bin`
# never appears, and `npm test`/`npm run build` answer "'vitest' is not
# recognized" / "'tsc' is not recognized" (measured 2026-09-23: `added 78
# packages, audited 79`, no .bin). CI sets no NODE_ENV, so it never shows there.
# Pinning include=dev here makes the documented `npm --prefix app ci` correct in
# every environment instead of relying on each worker remembering a flag.
include=dev
