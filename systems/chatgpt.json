  "css": ":root {\n  /* =========================================================\n     COLOR SYSTEM\n     ========================================================= */\n\n  /* Yüzey / Elevation */\n  --color-bg: #f8fafc;\n  --color-surface: #ffffff;\n  --color-surface-raised: #ffffff;\n  --color-surface-overlay: #ffffff;\n  --color-surface-sunken: #f1f5f9;\n\n  /* Metin */\n  --color-text: #0f172a;\n  --color-text-secondary: #475569;\n  --color-text-muted: #64748b;\n  --color-text-disabled: #94a3b8;\n  --color-text-link: #4f46e5;\n  --color-text-inverse: #ffffff;\n\n  /* Kenarlık / Çizgi */\n  --color-border: #e2e8f0;\n  --color-border-subtle: #f1f5f9;\n  --color-border-strong: #cbd5e1;\n  --color-divider: #e2e8f0;\n\n  /* Accent / Brand */\n  --color-accent: #4f46e5;\n  --color-accent-hover: #4338ca;\n  --color-accent-active: #3730a3;\n  --color-accent-subtle: #eef2ff;\n  --color-accent-muted: #c7d2fe;\n  --color-accent-border: #a5b4fc;\n  --color-accent-text: #4338ca;\n  --color-on-accent: #ffffff;\n\n  /* Etkileşim */\n  --color-focus-ring: #818cf8;\n  --color-hover-overlay: rgb(15 23 42 / 0.04);\n  --color-active-overlay: rgb(15 23 42 / 0.08);\n  --color-selected: #eef2ff;\n\n  /* =========================================================\n     SEMANTIC COLORS\n     ========================================================= */\n\n  /* Success */\n  --color-success: #16a34a;\n  --color-success-subtle: #f0fdf4;\n  --color-success-muted: #bbf7d0;\n  --color-success-border: #86efac;\n  --color-success-text: #15803d;\n  --color-on-success: #ffffff;\n\n  /* Warning */\n  --color-warning: #d97706;\n  --color-warning-subtle: #fffbeb;\n  --color-warning-muted: #fde68a;\n  --color-warning-border: #fcd34d;\n  --color-warning-text: #b45309;\n  --color-on-warning: #ffffff;\n\n  /* Danger */\n  --color-danger: #dc2626;\n  --color-danger-subtle: #fef2f2;\n  --color-danger-muted: #fecaca;\n  --color-danger-border: #fca5a5;\n  --color-danger-text: #b91c1c;\n  --color-on-danger: #ffffff;\n\n  /* Info */\n  --color-info: #0284c7;\n  --color-info-subtle: #f0f9ff;\n  --color-info-muted: #bae6fd;\n  --color-info-border: #7dd3fc;\n  --color-info-text: #0369a1;\n  --color-on-info: #ffffff;\n\n  /* Alfa / Overlay */\n  --color-scrim: rgb(15 23 42 / 0.56);\n  --color-shadow: rgb(15 23 42 / 0.12);\n  --color-tint-subtle: rgb(79 70 229 / 0.04);\n\n\n  /* =========================================================\n     TYPOGRAPHY\n     ========================================================= */\n\n  /* Font Ailesi */\n  --font-sans:\n    Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,\n    \"Segoe UI\", sans-serif;\n\n  --font-serif:\n    Georgia, Cambria, \"Times New Roman\", serif;\n\n  --font-mono:\n    \"SFMono-Regular\", Consolas, \"Liberation Mono\", monospace;\n\n  /* Yazı Boyutu */\n  --font-size-xs: 0.75rem;      /* 12px */\n  --font-size-sm: 0.875rem;     /* 14px */\n  --font-size-base: 1rem;       /* 16px */\n  --font-size-lg: 1.125rem;     /* 18px */\n  --font-size-xl: 1.25rem;      /* 20px */\n  --font-size-2xl: 1.5rem;      /* 24px */\n  --font-size-3xl: 1.875rem;    /* 30px */\n  --font-size-4xl: 2.25rem;     /* 36px */\n  --font-size-5xl: 3rem;        /* 48px */\n\n  /* Yazı Ağırlığı */\n  --font-weight-regular: 400;\n  --font-weight-medium: 500;\n  --font-weight-semibold: 600;\n  --font-weight-bold: 700;\n\n  /* Satır Yüksekliği */\n  --line-height-tight: 1.2;\n  --line-height-snug: 1.375;\n  --line-height-normal: 1.5;\n  --line-height-relaxed: 1.625;\n\n  /* Harf Aralığı */\n  --letter-spacing-tight: -0.025em;\n  --letter-spacing-normal: 0;\n  --letter-spacing-wide: 0.025em;\n\n\n  /* =========================================================\n     SPACING\n     ========================================================= */\n\n  --space-0: 0;\n  --space-px: 1px;\n  --space-0-5: 0.125rem;  /* 2px */\n  --space-1: 0.25rem;     /* 4px */\n  --space-2: 0.5rem;      /* 8px */\n  --space-3: 0.75rem;     /* 12px */\n  --space-4: 1rem;        /* 16px */\n  --space-5: 1.25rem;     /* 20px */\n  --space-6: 1.5rem;      /* 24px */\n  --space-8: 2rem;        /* 32px */\n  --space-10: 2.5rem;     /* 40px */\n  --space-12: 3rem;       /* 48px */\n  --space-16: 4rem;       /* 64px */\n  --space-20: 5rem;       /* 80px */\n  --space-24: 6rem;       /* 96px */\n\n\n  /* =========================================================\n     RADIUS\n     ========================================================= */\n\n  --radius-none: 0;\n  --radius-sm: 0.25rem;    /* 4px */\n  --radius-md: 0.375rem;   /* 6px */\n  --radius-lg: 0.5rem;     /* 8px */\n  --radius-xl: 0.75rem;    /* 12px */\n  --radius-2xl: 1rem;      /* 16px */\n  --radius-full: 9999px;\n\n\n  /* =========================================================\n     BORDER WIDTH\n     ========================================================= */\n\n  --border-width-none: 0;\n  --border-width-thin: 1px;\n  --border-width-thick: 2px;\n\n\n  /* =========================================================\n     SIZES\n     ========================================================= */\n\n  /* Icon */\n  --size-icon-sm: 1rem;      /* 16px */\n  --size-icon-md: 1.25rem;   /* 20px */\n  --size-icon-lg: 1.5rem;    /* 24px */\n\n  /* Controls */\n  --size-control-sm: 2rem;      /* 32px */\n  --size-control-md: 2.5rem;    /* 40px */\n  --size-control-lg: 3rem;      /* 48px */\n\n\n  /* =========================================================\n     SHADOW / ELEVATION\n     ========================================================= */\n\n  --shadow-xs:\n    0 1px 2px rgb(15 23 42 / 0.04);\n\n  --shadow-sm:\n    0 1px 3px rgb(15 23 42 / 0.08),\n    0 1px 2px rgb(15 23 42 / 0.04);\n\n  --shadow-md:\n    0 4px 6px -1px rgb(15 23 42 / 0.08),\n    0 2px 4px -2px rgb(15 23 42 / 0.06);\n\n  --shadow-lg:\n    0 10px 15px -3px rgb(15 23 42 / 0.10),\n    0 4px 6px -4px rgb(15 23 42 / 0.06);\n\n  --shadow-xl:\n    0 20px 25px -5px rgb(15 23 42 / 0.10),\n    0 8px 10px -6px rgb(15 23 42 / 0.06);\n\n  --shadow-2xl:\n    0 25px 50px -12px rgb(15 23 42 / 0.18);\n\n  --shadow-inner:\n    inset 0 2px 4px rgb(15 23 42 / 0.05);\n\n  --shadow-focus:\n    0 0 0 3px rgb(129 140 248 / 0.30);\n\n\n  /* =========================================================\n     MOTION\n     ========================================================= */\n\n  /* Süre */\n  --duration-instant: 0ms;\n  --duration-fast: 100ms;\n  --duration-normal: 200ms;\n  --duration-slow: 300ms;\n  --duration-slower: 500ms;\n\n  /* Easing */\n  --ease-linear: linear;\n  --ease-in: cubic-bezier(0.4, 0, 1, 1);\n  --ease-out: cubic-bezier(0, 0, 0.2, 1);\n  --ease-in-out: cubic-bezier(0.4, 0, 0.2, 1);\n  --ease-spring: cubic-bezier(0.34, 1.56, 0.64, 1);\n\n\n  /* =========================================================\n     Z-INDEX\n     ========================================================= */\n\n  --z-base: 0;\n  --z-dropdown: 1000;\n  --z-sticky: 1100;\n  --z-overlay: 1200;\n  --z-modal: 1300;\n  --z-popover: 1400;\n  --z-toast: 1500;\n  --z-tooltip: 1600;\n\n\n  /* =========================================================\n     BREAKPOINTS\n     ========================================================= */\n\n  --breakpoint-sm: 640px;\n  --breakpoint-md: 768px;\n  --breakpoint-lg: 1024px;\n  --breakpoint-xl: 1280px;\n  --breakpoint-2xl: 1536px;\n}",
